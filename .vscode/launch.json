{
  "configurations": [
    {
      "name": "Debug Intel i69",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}\\Intel-i69.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "MIMode": "gdb",
      "miDebuggerPath": "D:\\CPP\\mingw64\\bin\\gdb.exe",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "description": "Set Disassembly Flavor to Intel",
          "text": "-gdb-set disassembly-flavor intel",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "Build Intel i69"
    }
  ],
  "version": "2.0.0"
}
